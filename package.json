{
  "name": "modernize",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:iis": "ng build -c=production-iis --base-href /wms-lluvia-v2/ && node copy-to-iis.js",
    "build:smarterasp": "ng build -c=production-smarterasp",
    "deploy:ftp": "node deploy-ftp.js",
    "deploy": "npm run build:smarterasp && npm run deploy:ftp",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve-prod": "serve -s dist -l ${PORT:-3000}",
    "e2e": "cypress run --e2e --browser chrome",
    "e2e:open": "cypress open --e2e"
  },
  "private": true,
  "dependencies": {
