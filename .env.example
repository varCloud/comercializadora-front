# Copia este archivo a `.env` (git-ignorado) y completa con las credenciales reales.
# Usado por deploy-ftp.js — despliegue del build de producción a SmarterASP.NET.

FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# La cuenta FTP de SmarterASP.NET ya queda enjaulada en la carpeta del sitio (verificado con
# ftp-front: pwd inicial es "/" y ESE "/" ya es /admin-v2 — cd a otra ruta como /admin-v2 o
# /Admin falla con 550, no son visibles desde esta cuenta). Por eso el remoto es "/", no una
# subcarpeta. Verifica lo mismo (pwd tras conectar) antes de cambiar este valor.
FTP_REMOTE_DIR=/
FTP_SECURE=true
FTP_LOCAL_DIR=dist
